# ---------------------------------------------------------------------------
# GSTR-2B Reconciliation — backend environment configuration
#
# Copy this file to backend/.env and adjust. Never commit backend/.env.
#   cp backend/.env.example backend/.env
# ---------------------------------------------------------------------------

# Environment: development | staging | production
ENVIRONMENT=development
DEBUG=true

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development runs PostgreSQL in Docker (see docker-compose.yml at the
# project root). It is published on port 5433, not 5432, so it does not clash
# with a PostgreSQL service installed natively on the machine.
#
#   1. cp .env.example .env            (in the project root, then set a password)
#   2. docker compose up -d postgres
#   3. put the same password in the URL below
#
DATABASE_URL=postgresql+psycopg://gstr2b:CHANGE_ME@127.0.0.1:5433/gstr2b
#
# SQLite still works with zero setup and is what the test suite uses by
# default, but it does not enforce foreign keys, CHECK constraints or the
# audit-log trigger, so problems in those only appear on PostgreSQL. To use it,
# comment out the line above (the default is backend/data/gstr2b.db).

# ---------------------------------------------------------------------------
# API server / CORS
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list of allowed browser origins (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Matching engine tolerances
# ---------------------------------------------------------------------------
# Rupee tolerance for an exact taxable-value match.
EXACT_MATCH_VALUE_TOLERANCE=1.0
# Rupee tolerance when the invoice number differs only by formatting.
FORMATTING_VALUE_TOLERANCE=10.0
# Days either side of the book invoice date to still call it the same invoice.
FORMATTING_DATE_TOLERANCE_DAYS=3
# difflib similarity threshold for the near-identical invoice number fallback.
SIMILAR_INVOICE_NUMBER_RATIO=0.92
# Date window used when invoice numbers match exactly but values differ.
VALUE_MISMATCH_DATE_WINDOW_DAYS=10

# ---------------------------------------------------------------------------
# Secrets — REQUIRED.
#
# In development, a temporary key is generated at startup if these are blank,
# with a warning; sessions then do not survive a restart. In staging and
# production a blank value is a hard startup failure, because a shared
# default signing key is indistinguishable from having no authentication.
# ---------------------------------------------------------------------------
# Signs JWT access tokens.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Fernet key encrypting GSP consent tokens and TOTP secrets at rest.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this makes everything already encrypted unreadable. Keep a backup.
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60
INVITATION_TTL_DAYS=7

# Account lockout after repeated failed sign-ins.
MAX_FAILED_LOGINS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Refresh-token cookie. `secure` must stay false over plain http://localhost
# or the browser silently drops the cookie; it is forced true outside
# development regardless of this setting.
REFRESH_COOKIE_NAME=gstr2b_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_AUTH=10/minute

# ---------------------------------------------------------------------------
# Outbound email and SMS
#
# "console" logs the message instead of sending it, so local development
# needs no third-party accounts. Invitation and password-reset links appear
# in the backend log in full. Swap in a real provider once one is chosen.
# ---------------------------------------------------------------------------
# "console" logs the message; "resend" sends through Resend (https://resend.com).
EMAIL_PROVIDER=console
SMS_PROVIDER=console
# Required when EMAIL_PROVIDER=resend. Create a key in the Resend dashboard.
RESEND_API_KEY=
# The sender address. With Resend this must belong to a domain you have
# verified there (add the DNS records it gives you), or sends are rejected
# with a 403. `onboarding@resend.dev` works for testing only, and delivers
# only to the address that owns the Resend account.
EMAIL_FROM=no-reply@gstr2b.local
# Base URL used to build invitation and reset links.
APP_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Live GST portal access (GSP)
#
# GSP_PROVIDER=mock needs no credentials: it returns bundled sample data and
# accepts the OTP 123456, so the whole connect-and-fetch flow works locally. It
# is REFUSED when ENVIRONMENT is not "development", because it fabricates
# filings. Use sandbox for anything real.
# ---------------------------------------------------------------------------
GSP_PROVIDER=mock
GSP_HTTP_TIMEOUT_SECONDS=30

# Sandbox.co.in (https://developer.sandbox.co.in). Create an API key and secret
# in their dashboard. The test host is https://test-api.sandbox.co.in
SANDBOX_BASE_URL=https://api.sandbox.co.in
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
SANDBOX_API_VERSION=1.0.0
# Sandbox describes the GSTR-2B `year` path parameter as the FINANCIAL year, but
# its GSTR-1 endpoints use the calendar year and the documentation has a single
# example. If fetching January to March returns "not available", flip this to
# `calendar`.
SANDBOX_GSTR2B_YEAR_BASIS=financial

# OTP consent guard rails
GSP_OTP_TTL_MINUTES=10
GSP_OTP_MAX_VERIFY_ATTEMPTS=3
# Each OTP request texts the client's phone, so this is a harassment limit as
# much as a rate limit.
GSP_OTP_MAX_REQUESTS_PER_HOUR=5
# Refresh a 6-hour taxpayer token when less than this remains.
GSP_TOKEN_REFRESH_MARGIN_MINUTES=90
MOCK_GSP_SESSION_HOURS=168

# ---------------------------------------------------------------------------
# Background jobs (Celery + Redis)
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_TIMEZONE=Asia/Kolkata
# GSTN generates GSTR-2B on the 14th. The job runs on each day listed and skips
# GSTINs already fetched, so the later days are second and third chances.
GSTR2B_FETCH_DAYS=14,15,16
GSTR2B_FETCH_HOUR=6
# Attempts per GSTIN per fetch, with exponential backoff (1, 2, 4, 8, 16 minutes).
GSTR2B_FETCH_MAX_ATTEMPTS=6

# ---------------------------------------------------------------------------
# GST notices: storage, reading, analysis, alerts
# ---------------------------------------------------------------------------
# Uploaded notices are encrypted with ENCRYPTION_KEY before they are written.
# LOSE THAT KEY AND EVERY STORED NOTICE BECOMES UNREADABLE, so back it up
# somewhere other than this machine.
STORAGE_BACKEND=local
# Defaults to backend/data/files. In production, put this on a backed-up volume.
# STORAGE_LOCAL_DIR=
MAX_NOTICE_UPLOAD_MB=15

# "mock" is a keyword-based reader for local development: no key, no network,
# and it labels everything low confidence. It is refused outside development.
# "claude" sends the notice text (and, when drafting, the client's reconciliation
# records for the notice's period) to the Anthropic API.
NOTICE_AI_PROVIDER=mock
# Only needed when NOTICE_AI_PROVIDER=claude. Put the key here, never in chat.
ANTHROPIC_API_KEY=
NOTICE_AI_MODEL=claude-opus-5
NOTICE_AI_TIMEOUT_SECONDS=120
# A notice longer than this is refused rather than silently truncated.
NOTICE_AI_MAX_INPUT_CHARS=200000
# Most reconciliation records handed to the drafter as evidence.
NOTICE_EVIDENCE_MAX_ITEMS=60

# Deadline alerts go out this many days before a notice response is due. "Due
# today" and "overdue" alerts are always on.
NOTICE_ALERT_DAYS=7,3,1
NOTICE_ALERT_HOUR=8

# OCR for photographed notices is optional. Install Tesseract, then
# `pip install pytesseract pillow`, and set this if it is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
